generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  PRINCIPAL
  TEACHER
  PARENT
  STUDENT
}

/*
  Added for future Student Admission Module
*/
enum AdmissionStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id        Int      @id @default(autoincrement())
  fullName  String
  email     String   @unique
  password  String
  role      Role
  phone     String?
  status    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Notice {
  id          Int      @id @default(autoincrement())
  title       String
  description String
  createdAt   DateTime @default(now())
}

model ContactMessage {
  id        Int      @id @default(autoincrement())
  name      String
  email     String
  subject   String
  message   String
  createdAt DateTime @default(now())
}

model TeacherApplication {
  id            Int      @id @default(autoincrement())
  fullName      String
  email         String
  phone         String
  subject       String
  qualification String
  experience    String

  resumeUrl      String?
  certificateUrl String?

  status String @default("PENDING")

  createdAt DateTime @default(now())
}


model StudentAdmission {
  id          Int             @id @default(autoincrement())
  fullName    String
  email       String
  phone       String
  className   String

  photoUrl    String?
  documentUrl String?

  status      AdmissionStatus @default(PENDING)

  createdAt   DateTime @default(now())
}